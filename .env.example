# "rules" (default): no API calls. "live": use Claude for translating questions and drafting messages.
CASHSENSE_AI_MODE=rules

# For live Claude responses only, set these on the server.
# Never use NEXT_PUBLIC_ for these values.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5   (default if unset)

# Server-only URL for local Python service. Do not use NEXT_PUBLIC_.
CASHSENSE_BACKEND_URL=http://127.0.0.1:8000
# Shared only between the Next.js server and FastAPI. Generate a unique random
# value and configure it in both hosts' secret environment variable stores.
CASHSENSE_BACKEND_TOKEN=
